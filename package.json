{
  "name": "@zakkster/lite-bisect",
  "version": "0.0.0",
  "description": "Zero-GC binary search kernels for sorted typed arrays: branchless and branchy lower / upper bound, a galloping hint search, segment and nearest, one monomorphic copy per array type (Float64, Float32, Uint32, Uint16, Int32).",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "type": "module",
  "main": "./Bisect.js",
  "module": "./Bisect.js",
  "types": "./Bisect.d.ts",
  "exports": {
    ".": {
      "types": "./Bisect.d.ts",
      "node": "./Bisect.js",
      "import": "./Bisect.js",
      "default": "./Bisect.js"
    }
  },
  "files": [
    "Bisect.js",
    "Bisect.d.ts",
    "llms.txt",
    "LICENSE.txt",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "test": "node --test \"test/*.test.mjs\"",
    "torture": "node --expose-gc test/torture.mjs",
    "gates": "node --test test/gates/alloc.test.mjs test/gates/bytecode.test.mjs",
    "gates:local": "LITE_UTILS_DIR=../LiteUtils npm run gates",
    "test:types": "node --test test/types.test.mjs test/types.exports.test.mjs",
    "coverage": "c8 --include=Bisect.js --temp-directory node_modules/.c8/tmp --report-dir node_modules/.c8/report --reporter=text --reporter=text-summary --check-coverage --lines 100 --branches 100 node --test \"test/!(*.inline|*.mutants).test.mjs\""
  },
  "keywords": [
    "binary-search",
    "bisect",
    "lower-bound",
    "upper-bound",
    "branchless",
    "sorted",
    "typed-array",
    "zero-gc",
    "zero-allocation",
    "zakkster"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "dependencies": {},
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.16.0",
    "@zakkster/lite-leak": "^1.10.0",
    "@zakkster/lite-signal": "^1.5.2",
    "c8": "^12.0.0",
    "typescript": "7.0.2"
  }
}
